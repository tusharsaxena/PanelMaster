## Interface: 120007
## Title: Ka0s Panel Master
## Notes: Draws plain backdrop panels behind your UI, so separate frames read as deliberate groups.
## Author: add1kted2ka0s
## Version: 1.0.0
## IconTexture: Interface\Icons\pvp_rune_random
## SavedVariables: PanelMasterDB
## OptionalDeps: Ace3, LibStub, CallbackHandler-1.0, LibSharedMedia-3.0, AceGUI-3.0-SharedMediaWidgets
## DefaultState: enabled
## Category-enUS: UI
## X-License: MIT
## X-Standard: https://github.com/tusharsaxena/WowAddonStandards
## X-Curse-Project-ID: 1642836

# Libraries (vendored in libs/ — load first)
libs\LibStub\LibStub.lua
libs\CallbackHandler-1.0\CallbackHandler-1.0.xml
libs\AceAddon-3.0\AceAddon-3.0.xml
libs\AceEvent-3.0\AceEvent-3.0.xml
libs\AceTimer-3.0\AceTimer-3.0.xml
libs\AceConsole-3.0\AceConsole-3.0.xml
libs\AceDB-3.0\AceDB-3.0.xml
libs\AceGUI-3.0\AceGUI-3.0.xml
libs\AceConfig-3.0\AceConfig-3.0.xml
libs\AceDBOptions-3.0\AceDBOptions-3.0.lua
libs\LibSharedMedia-3.0\lib.xml
libs\AceGUI-3.0-SharedMediaWidgets\widget.xml
# LibKa0s AFTER LibStub and after Ace3: Core resolves LibStub, and DebugLog/Slash/Options each
# resolve LibKa0s-Core-1.0 before calling NewLibrary. Vendored whole-folder from ../LibKa0s.
libs\LibKa0s\LibKa0s.xml

# Locales
locales\enUS.lua
locales\PostLoad.lua

# Core (Compat loads first)
core\Compat.lua
core\LSMPatch.lua
# MediaSetup BEFORE Constants, and that position is load-bearing rather than conventional:
# core/Constants.lua resolves C.FONT_MONO from NS.MediaFont at FILE LOAD, so a seam published
# later would leave the constant holding nil forever. It needs nothing but its own addonName
# vararg and LibStub, both of which are already here.
core\MediaSetup.lua
core\Constants.lua
core\Namespace.lua
core\State.lua
core\Util.lua
# CoreSetup AFTER Namespace (NS.PREFIX) and Util (NS.Util), and BEFORE PanelMaster.lua, whose
# AceConsole embed reclaims NS.Print from NS.Util.print. See the header of the file.
core\CoreSetup.lua
# The LibKa0s-DebugLog seam. After Constants (C.FONT_MONO) and after CoreSetup
# (NS.LIBKA0S_MISSING). Everything else it touches is reached through a closure, so the console no
# longer has to sit down in modules/ the way modules/DebugLog.lua did.
core\DebugLogSetup.lua
core\PanelMaster.lua
core\Database.lua

# Defaults
defaults\Profile.lua
defaults\Global.lua

# Modules (Registry before Canvas — the renderer reads the registry)
modules\Registry.lua
# Artwork before Canvas — the renderer reads its art list and geometry math
modules\Artwork.lua
# The known-pack manifest, before the adapter that reads it. Pure data, no behavior: what the
# official Sunn packs contain, so the feature survives SunnArt itself being disabled or unloadable.
modules\SunnArtPacks.lua
# The Sunn - Viewport Art adapter, AFTER Artwork (it appends to Artwork.Catalog) and before Canvas.
# Discovery only: it reads globals that user-installed pack addons leave behind and ships no art of
# its own. Silent when nothing Sunn-shaped is installed.
modules\SunnArt.lua
modules\Canvas.lua
modules\Unlock.lua

# Settings (last — depend on everything else being initialized)
settings\Schema.lua
settings\Slash.lua
settings\PanelEditor.lua
# The LibKa0s-Options seam. After Schema.lua (the descriptor reads it) and Slash.lua (the landing
# page renders through Sl:LandingRows), and BEFORE Panel.lua, which captures the instance at file
# scope. PanelEditor.lua binds its helpers lazily inside its own rebuild, so it pins nothing here.
settings\OptionsSetup.lua
settings\Panel.lua
