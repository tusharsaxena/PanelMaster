package-as: PanelMaster

# Libraries are vendored in libs/ and committed to git — NOT fetched as externals.

ignore:
  - .luacheckrc
  - .gitignore
  - docs        # holds docs/audits/ and docs/reviews/ too — all dev-only
  - tests
  - tools       # the artwork importer — build-time only, and not even Lua
  - _dev
  - "*.bak"
  - media/screenshots   # project-page art, served from the CurseForge CDN — never downloaded by a player
  # Only the .tga logo is loadable at runtime; WoW cannot read .png or .jpg at all. The master .png
  # and the two .jpg renders exist for the project page and for regenerating the .tga, so shipping
  # them would add megabytes to every download for files the client physically cannot use.
  - media/logos/*.png
  - media/logos/*.jpg
  # The source plate every bundled artwork was converted FROM, kept in git so an asset can be
  # re-derived (a different size, a fixed margin, a corrected watermark erase) without going back
  # to whoever generated it. Same reasoning as the logo above: WoW cannot load a .png, so shipping
  # these would add megabytes per download for files the client physically cannot use.
  #
  # Each raw file is named for the catalog id it produces, so media/artwork/raw/alliance-crest.png
  # is unambiguously the source of media/artwork/alliance-crest.tga.
  - media/artwork/raw
  # The contact sheet of every bundled piece, generated by tools/artwork/make_poster.py and embedded
  # in the README. Same reasoning as the logo renders and the raw plates: WoW cannot load a .png at
  # all, so shipping a multi-megabyte one would add that weight to every download for a file the
  # client physically cannot use. It is committed so the README renders on GitHub without a clone.
  - media/poster
